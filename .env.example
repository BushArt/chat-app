# Chat App — Environment Variables
# Copy this file to .env and fill in real values for local development.

# ─────────────────────────────────────────
# Required
# ─────────────────────────────────────────

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://yourname:yourpassword@cluster0.xxxxx.mongodb.net/chatapp

# Secret key for signing JWT tokens (any long random string)
JWT_SECRET=replacethiswithanyverylongrandomstring

# Port the server listens on (default: 3000)
PORT=3000

# ─────────────────────────────────────────
# Required in Production
# ─────────────────────────────────────────

# Cloudinary URL for avatar and file uploads
# Get from: Cloudinary Dashboard → API Keys
# Note: On some local Windows Node.js setups, Cloudinary TLS verification may fail.
# If so, run the dev server with: NODE_OPTIONS=--use-system-ca
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Allowed CORS origin (e.g., your Railway URL)
CLIENT_ORIGIN=https://your-app.up.railway.app

# ─────────────────────────────────────────
# Optional
# ─────────────────────────────────────────

# bcrypt hashing rounds (default: 10)
BCRYPT_ROUNDS=10

# ─────────────────────────────────────────
# Required for E2E Tests Only
# ─────────────────────────────────────────

# Separate test database (E2E tests will DROP this database)
# Optional when mongodb-memory-server fallback is used locally/CI
TEST_MONGO_URI=mongodb+srv://yourname:yourpassword@cluster0.xxxxx.mongodb.net/chatapp_test