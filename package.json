{
  "name": "chat-app",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest --selectProjects server client && jest --selectProjects server-sockets --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "npx jest --selectProjects e2e --runInBand",
    "test:regressions": "jest __tests__/client/visual.regressions.test.js __tests__/client/ui.behavior.test.js",
    "test:browser": "playwright test",
    "test:ci": "jest --selectProjects server client --coverage --ci --reporters=default && jest --selectProjects server-sockets --runInBand --ci --reporters=default && npx jest --selectProjects e2e --runInBand --ci --reporters=default"
  },
  "jest": {
    "projects": [
      {
        "displayName": "server",
        "testEnvironment": "node",
        "testMatch": [
          "**/__tests__/unit/**/*.test.js",
          "**/__tests__/integration/routes/**/*.test.js"
        ],
        "testPathIgnorePatterns": [
          "/__tests__/unit/public/"
        ]
      },
      {
        "displayName": "server-sockets",
        "testEnvironment": "node",
        "testMatch": [
          "**/__tests__/integration/sockets/**/*.test.js"
        ],
        "maxWorkers": 1,
        "forceExit": true
      },
      {
        "displayName": "client",
        "testEnvironment": "jsdom",
        "testMatch": [
          "**/__tests__/unit/public/**/*.test.js",
          "**/__tests__/client/**/*.test.js"
        ]
      },
      {
        "displayName": "e2e",
        "testEnvironment": "node",
        "testMatch": [
          "**/__tests__/e2e/**/*.test.js"
        ],
        "globalSetup": "<rootDir>/__tests__/e2e/globalSetup.js",
        "globalTeardown": "<rootDir>/__tests__/e2e/globalTeardown.js",
        "testTimeout": 30000,
        "maxWorkers": 1
      }
    ],
    "coverageProvider": "v8",
    "collectCoverageFrom": [
      "middleware/**/*.js",
      "models/**/*.js",
      "routes/**/*.js",
      "sockets/**/*.js",
      "config/**/*.js",
      "public/js/modules/utils.js",
      "public/js/modules/state.js",
      "public/js/modules/api.js",
      "public/js/modules/optimistic.js",
      "public/js/modules/ui.js",
      "public/js/modules/socket.js",
      "public/js/modules/recorder.js",
      "public/js/app.js"
    ],
    "testTimeout": 10000,
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 75,
        "functions": 80,
        "lines": 80
      },
      "config/cloudinary.js": {
        "statements": 70,
        "branches": 50,
        "functions": 70,
        "lines": 70
      },
      "middleware/upload.js": {
        "statements": 95,
        "branches": 90,
        "functions": 95,
        "lines": 95
      },
      "public/js/modules/recorder.js": {
        "statements": 80,
        "branches": 70,
        "functions": 80,
        "lines": 80
      }
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.3",
    "multer": "^2.1.1",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@playwright/test": "^1.60.0",
    "dotenv": "^17.4.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "mongodb-memory-server": "^11.2.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  }
}
