{
  "name": "chat-app",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "projects": [
      {
        "displayName": "server",
        "testEnvironment": "node",
        "testMatch": [
          "**/__tests__/unit/**/*.test.js",
          "**/__tests__/integration/**/*.test.js"
        ],
        "testPathIgnorePatterns": [
          "/__tests__/unit/public/"
        ]
      },
      {
        "displayName": "client",
        "testEnvironment": "jsdom",
        "testMatch": [
          "**/__tests__/unit/public/**/*.test.js"
        ]
      }
    ],
    "coverageProvider": "v8",
    "collectCoverageFrom": [
      "middleware/**/*.js",
      "models/**/*.js",
      "routes/**/*.js",
      "sockets/**/*.js",
      "public/js/modules/utils.js",
      "public/js/modules/state.js",
      "public/js/modules/api.js",
      "public/js/modules/optimistic.js",
      "public/js/modules/ui.js",
      "public/js/modules/socket.js"
    ],
    "testTimeout": 10000,
    "coverageThreshold": {
      "global": {
        "statements": 70,
        "branches": 70,
        "functions": 45,
        "lines": 70
      }
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.3",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  }
}
